<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:HMControls;assembly=HMControls"
             xmlns:me="clr-namespace:HMControlsSample"
             x:Class="HMControlsSample.MainPage"
             x:DataType="me:MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="15"
            Spacing="5">
            <ctrl:StandardEntry Text="Standard Entry" 
                                Placeholder="Standard Entry"
                                Style="{StaticResource StandardEntryStyle}"/>
            <me:MyKeyboardlessEntry Text="KeyboardlessEntry"
                                    Style="{StaticResource StandardEntryStyle}"/>
            <ctrl:SelectableEditor Text="KeyboardlessEditor"
                                   Command="{Binding SelectableEitorCommand}"
                                   Style="{StaticResource SelectableEditorStyle}"/>
            <ctrl:StandardSearchBar Text="StandarsSearchBar"
                                    Style="{StaticResource HeaderSearchBarStyle}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
